[Unit]
Description=vframe media display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/vframe
Environment=VFRAME_MPV_ARGS=--vo=drm
ExecStart=/home/pi/vframe/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
